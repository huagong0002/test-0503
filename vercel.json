{
  "version": 2,
  "builds": [
    {
      "src": "api/test.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/health.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/login.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/register.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/materials/sync.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/materials.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/materials/[id].ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/test",
      "dest": "/api/test.js"
    },
    {
      "src": "/api/health",
      "dest": "/api/health.ts"
    },
    {
      "src": "/api/login",
      "dest": "/api/login.ts"
    },
    {
      "src": "/api/register",
      "dest": "/api/register.ts"
    },
    {
      "src": "/api/materials/sync",
      "dest": "/api/materials/sync.ts"
    },
    {
      "src": "/api/materials",
      "dest": "/api/materials.ts"
    },
    {
      "src": "/api/materials/(.*)",
      "dest": "/api/materials/[id].ts"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/$1"
    }
  ]
}