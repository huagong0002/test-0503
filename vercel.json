{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/health",
      "dest": "/api/health.ts"
    },
    {
      "src": "/api/login",
      "dest": "/api/login.ts"
    },
    {
      "src": "/api/register",
      "dest": "/api/register.ts"
    },
    {
      "src": "/api/materials/sync",
      "dest": "/api/materials.ts"
    },
    {
      "src": "/api/materials$",
      "dest": "/api/materials.ts"
    },
    {
      "src": "/api/materials/(.*)",
      "dest": "/api/materials/[id].ts",
      "methods": ["DELETE"]
    },
    {
      "src": "/(.*)",
      "dest": "/dist/$1"
    }
  ]
}