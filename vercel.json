{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/materials/sync",
      "dest": "/api/materials/sync.ts",
      "methods": ["POST"]
    },
    {
      "src": "/api/materials",
      "dest": "/api/materials.ts",
      "methods": ["GET"]
    },
    {
      "src": "/api/materials/(.*)",
      "dest": "/api/materials/[id].ts",
      "methods": ["DELETE"]
    },
    {
      "src": "/api/health",
      "dest": "/api/health.ts",
      "methods": ["GET"]
    },
    {
      "src": "/api/login",
      "dest": "/api/login.ts",
      "methods": ["POST"]
    },
    {
      "src": "/api/register",
      "dest": "/api/register.ts",
      "methods": ["POST"]
    },
    {
      "src": "/(.*)",
      "dest": "/dist/$1"
    }
  ]
}